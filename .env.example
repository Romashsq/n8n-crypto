# Aura Invest AI: environment variables for apps/web (Next.js on Vercel).
# Names only. Put real values in Vercel → Project → Settings → Environment Variables,
# or in apps/web/.env.local for local development (never commit it).

# --- Supabase (browser + server) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Safe in the browser: RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- n8n (server only) ---
# Base URL of production webhooks, without a trailing slash.
N8N_WEBHOOK_BASE_URL=https://<instance>.app.n8n.cloud/webhook
# Must equal the value stored in the n8n credential "Aura Webhook Key" (Header Auth, header X-Aura-Key).
N8N_WEBHOOK_KEY=

# --- Market data used directly by Next.js route handlers (server only) ---
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
COINGECKO_DEMO_API_KEY=
FRED_API_KEY=
# SEC asks for a descriptive User-Agent with a contact address.
SEC_USER_AGENT="AuraInvestAI/1.0 (contact: owner@example.com)"
